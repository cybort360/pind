modules = ["nodejs-20"]
run = "npm run dev"
entrypoint = "server/index.ts"

[nix]
channel = "stable-24_05"

[env]
# Public port shared by the Vite dev server and the production Express server.
PORT = "5000"
# Private port the Express API listens on in development; Vite proxies to it.
API_PORT = "3001"

# Replit exposes one HTTP port publicly. In development Vite serves the client
# on it and proxies /api and /uploads to the API; in production Express serves
# the built client and the API on it.
[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]
