# REQUIRED. Pind stores everything in PostgreSQL.
#   Replit: open the Database tool and click Create — DATABASE_URL is injected.
#   Local:  createdb pind
DATABASE_URL=postgres://localhost:5432/pind

# Set to true only if your provider presents a certificate chain Node cannot
# verify. Leave unset otherwise — it disables TLS verification.
DATABASE_SSL_NO_VERIFY=

# Used by the test suite; created automatically if absent.
TEST_DATABASE_URL=postgres://localhost:5432/pind_test

# Used for invite and approval emails. Optional in demo mode.
RESEND_API_KEY=
EMAIL_FROM=Pind <onboarding@resend.dev>

# Optional file storage. Without these values, files are stored locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional team notifications.
SLACK_WEBHOOK_URL=

# Public URL used in invite links. Leave blank to derive it from the request,
# which is what you want on Replit. Setting it also locks CORS to that origin.
APP_URL=

# Public port. Vite serves the client here in development; Express serves the
# built client and the API here in production. Replit injects this.
PORT=5000

# Private port the Express API listens on in development only. Vite proxies
# /api and /uploads to it. Not used in production.
API_PORT=3001
