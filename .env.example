# Copy this file to .env and fill in your own values. All of these are
# optional except DATABASE_URL. Keep your .env secret and never commit it.

# REQUIRED. PostgreSQL connection string. On Replit this is injected by the
# Database tool. Locally, create a database first (e.g. `createdb pind`).
DATABASE_URL=

# POSTGRES_DATABASE_URL=

# Set to true only if your provider offers a certificate chain Node cannot
# verify. Leave unset otherwise — it disables TLS verification.
DATABASE_SSL_NO_VERIFY=

# Used by the test suite only; created automatically if absent.
TEST_DATABASE_URL=

# Used for invite and approval emails. Optional — without it, emails are logged.
RESEND_API_KEY=

# From-name used on outgoing emails.
EMAIL_FROM=

# Optional file storage. Without these values, uploaded files are stored
# locally under the uploads/ directory.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional team notifications. Without a URL, approvals are not posted to Slack.
SLACK_WEBHOOK_URL=

# Public URL used in invite links. Leave blank to derive it from the request,
# which is what you want on Replit. Setting it also locks CORS to that origin.
APP_URL=

# Public port. Vite serves the client here in development; Express serves the
# built client and the API here in production. Replit injects this.
PORT=

# Private port the Express API listens on in development only. Vite proxies
# /api and /uploads to it. Not used in production.
API_PORT=

# Length of an authenticated session before sign-out, in days.
SESSION_TTL_DAYS=

# Feature flags. Set to "true" to enable, unset otherwise.
FEATURE_REQUIRE_CLIENT_NAME=
FEATURE_ALLOW_DOWNLOADS=
FEATURE_SHOW_REVISION_HISTORY=